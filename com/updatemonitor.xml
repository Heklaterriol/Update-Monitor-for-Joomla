    <license>GNU General Public License version 2 or later</license>
    <version>1.1.0</version>
    <description>COM_UPDATEMONITOR_XML_DESCRIPTION</description>
    <namespace path="src">Custom\Component\UpdateMonitor</namespace>
    <install><sql><file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file></sql></install>

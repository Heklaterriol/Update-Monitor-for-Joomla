<?xml version="1.0" encoding="UTF-8"?>
<config>
    <fieldset name="general" label="COM_UPDATEMONITOR_CFG_GENERAL">
        <field name="refresh" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_REFRESH" description="COM_UPDATEMONITOR_CFG_REFRESH_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="fetch_changelog" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_CHANGELOG" description="COM_UPDATEMONITOR_CFG_CHANGELOG_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="site_url" type="url" validate="url" hint="https://example.com/" label="COM_UPDATEMONITOR_CFG_SITEURL" description="COM_UPDATEMONITOR_CFG_SITEURL_DESC" />
        <field name="auto_check_on_open" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_AUTO_OPEN" description="COM_UPDATEMONITOR_CFG_AUTO_OPEN_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="debug_log" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_UPDATEMONITOR_CFG_DEBUG" description="COM_UPDATEMONITOR_CFG_DEBUG_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="max_check_age_hours" type="number" default="48" min="1" label="COM_UPDATEMONITOR_CFG_MAXAGE" description="COM_UPDATEMONITOR_CFG_MAXAGE_DESC" />
    </fieldset>
    <fieldset name="notifications" label="COM_UPDATEMONITOR_CFG_NOTIFICATIONS">
        <field name="mail_on_manual" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_MAIL_MANUAL" description="COM_UPDATEMONITOR_CFG_MAIL_MANUAL_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="mail_on_scheduled" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_MAIL_SCHEDULED" description="COM_UPDATEMONITOR_CFG_MAIL_SCHEDULED_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="include_super_users" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_SUPERUSERS" description="COM_UPDATEMONITOR_CFG_SUPERUSERS_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="extra_recipients" type="textarea" rows="3" label="COM_UPDATEMONITOR_CFG_EXTRA" description="COM_UPDATEMONITOR_CFG_EXTRA_DESC" />
        <field name="notify_new" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_NOTIFY_NEW">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="notify_increase" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_NOTIFY_INCREASE">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="reminder_days" type="number" default="7" min="0" label="COM_UPDATEMONITOR_CFG_REMINDER" description="COM_UPDATEMONITOR_CFG_REMINDER_DESC" />
    </fieldset>
    <fieldset name="reports" label="COM_UPDATEMONITOR_CFG_REPORTS">
        <field name="report_weekly" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_UPDATEMONITOR_CFG_WEEKLY">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="report_weekday" type="list" default="1" label="COM_UPDATEMONITOR_CFG_WEEKDAY">
            <option value="1">Monday / Montag</option><option value="2">Tuesday / Dienstag</option><option value="3">Wednesday / Mittwoch</option>
            <option value="4">Thursday / Donnerstag</option><option value="5">Friday / Freitag</option><option value="6">Saturday / Samstag</option><option value="7">Sunday / Sonntag</option>
        </field>
        <field name="report_monthly" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_UPDATEMONITOR_CFG_MONTHLY">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="report_monthday" type="number" default="1" min="1" max="28" label="COM_UPDATEMONITOR_CFG_MONTHDAY" />
    </fieldset>
    <fieldset name="retention" label="COM_UPDATEMONITOR_CFG_RETENTION">
        <field name="auto_cleanup" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_CLEANUP">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="log_retention_days" type="number" default="90" min="1" label="COM_UPDATEMONITOR_CFG_LOGDAYS" />
        <field name="history_retention_days" type="number" default="365" min="0" label="COM_UPDATEMONITOR_CFG_HISTDAYS" description="COM_UPDATEMONITOR_CFG_HISTDAYS_DESC" />
    </fieldset>
    <fieldset name="securitychecks" label="COM_UPDATEMONITOR_CFG_SECURITY">
        <field name="check_vel" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_CHECK_VEL" description="COM_UPDATEMONITOR_CFG_CHECK_VEL_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="check_platform" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_CHECK_PLATFORM" description="COM_UPDATEMONITOR_CFG_CHECK_PLATFORM_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="check_blindspots" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_CHECK_BLIND" description="COM_UPDATEMONITOR_CFG_CHECK_BLIND_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="stale_server_days" type="number" default="7" min="1" label="COM_UPDATEMONITOR_CFG_STALE_DAYS" />
        <field name="check_disabled" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_CHECK_DISABLED">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="notify_findings" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_UPDATEMONITOR_CFG_NOTIFY_FINDINGS" description="COM_UPDATEMONITOR_CFG_NOTIFY_FINDINGS_DESC">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
    </fieldset>
    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
        <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" validate="rules" filter="rules" component="com_updatemonitor" section="component" />
    </fieldset>
</config>
